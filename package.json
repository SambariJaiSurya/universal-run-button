{
  "name": "universal-run-button",
  "displayName": "Universal Run Button",
  "description": "Compile and run source files across 50+ languages in the VS Code integrated terminal.",
  "version": "0.1.0",
  "publisher": "local-developer",
  "repository": {
    "type": "git",
    "url": "https://github.com/SambariJaiSurya/universal-run-button.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "universal-runner.run",
        "title": "Run File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "universal-runner.run",
          "when": "(resourceExtname =~ /\\.(c|cpp|cc|cxx|m|mm|java|cs|vb|fs|fsx|rs|go|swift|kt|kts|scala|d|zig|nim|cr|v|odin|f|for|f90|f95|f03|f08|pas|pp|adb|ads|cob|cbl|asm|s|hs|lhs|ml|mli|sml|dpr|lisp|lsp|pl|pm|erl|ex|exs|clj|cljs|cljc|ts|dart|jl|r|sol|gd|cu|cuh|cl|sv|svh|vhd|vhdl|py|js|cjs|mjs|php|rb|lua|sh|bash|zsh|fish|ps1|psm1|bat|cmd|tcl|groovy|raku|rakumod|awk|sed|ahk|scpt|applescript|vbs|st|scm|ss|rkt|factor|pony|res|resi|re|rei|purs|elm|nu|html|htm|md|markdown|sql|css|scss|sass|less|vue|svelte|astro|jsx|tsx|tex|cmake|ino)$/i || resourceFilename =~ /^(Dockerfile|CMakeLists\\.txt|Makefile)$/i) && !isInDiffEditor",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Universal Run Button",
      "properties": {
        "universalRunner.toolPaths": {
          "type": "object",
          "default": {},
          "description": "Custom paths for compilers and interpreters (e.g. {\"python\": \"C:\\\\Path\\\\python.exe\", \"gcc\": \"/usr/bin/gcc\"})."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
