{
  "name": "universal-run-button",
  "displayName": "Universal Run Button",
  "description": "Compile and run source files across 50+ languages in the VS Code integrated terminal.",
  "version": "0.3.0",
  "publisher": "local-developer",
  "repository": {
    "type": "git",
    "url": "https://github.com/SambariJaiSurya/universal-run-button.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "universal-runner.run",
        "title": "Run File",
        "category": "Universal Runner",
        "icon": "$(play)"
      },
      {
        "command": "universal-runner.runHtmlLiveServer",
        "title": "Live Server",
        "category": "Universal Runner",
        "icon": "$(play)"
      },
      {
        "command": "universal-runner.runHtmlPath",
        "title": "Run Path (File Path)",
        "category": "Universal Runner",
        "icon": "$(play)"
      },
      {
        "command": "universal-runner.configureHtmlAction",
        "title": "Customize Default HTML Action...",
        "category": "Universal Runner",
        "icon": "$(gear)"
      },
      {
        "command": "universal-runner.stopLiveServer",
        "title": "Stop Live Server",
        "category": "Universal Runner",
        "icon": "$(debug-stop)"
      },
      {
        "command": "universal-runner.showLiveServerMenu",
        "title": "Live Server Options",
        "category": "Universal Runner",
        "icon": "$(radio-tower)"
      },
      {
        "command": "universal-runner.runMaz",
        "title": "Run MAZ File",
        "category": "Universal Runner",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "universal-runner.run",
          "when": "(resourceExtname =~ /\\.(c|cpp|cc|cxx|m|mm|java|cs|vb|fs|fsx|rs|go|swift|kt|kts|scala|d|zig|nim|cr|v|odin|f|for|f90|f95|f03|f08|pas|pp|adb|ads|cob|cbl|asm|s|hs|lhs|ml|mli|sml|dpr|lisp|lsp|pl|pm|erl|ex|exs|clj|cljs|cljc|ts|dart|jl|r|sol|gd|cu|cuh|cl|sv|svh|vhd|vhdl|py|js|cjs|mjs|php|rb|lua|sh|bash|zsh|fish|ps1|psm1|bat|cmd|tcl|groovy|raku|rakumod|awk|sed|ahk|scpt|applescript|vbs|st|scm|ss|rkt|factor|pony|res|resi|re|rei|purs|elm|nu|md|markdown|sql|css|scss|sass|less|vue|svelte|astro|jsx|tsx|tex|cmake|ino)$/i || resourceFilename =~ /^(Dockerfile|CMakeLists\\.txt|Makefile)$/i) && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "universal-runner.runHtmlLiveServer",
          "when": "resourceExtname =~ /\\.(html|htm)$/i && config.universalRunner.htmlDefaultAction != 'runPath' && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "universal-runner.runHtmlPath",
          "when": "resourceExtname =~ /\\.(html|htm)$/i && config.universalRunner.htmlDefaultAction != 'runPath' && !isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "universal-runner.runHtmlPath",
          "when": "resourceExtname =~ /\\.(html|htm)$/i && config.universalRunner.htmlDefaultAction == 'runPath' && !isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "universal-runner.runHtmlLiveServer",
          "when": "resourceExtname =~ /\\.(html|htm)$/i && config.universalRunner.htmlDefaultAction == 'runPath' && !isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "universal-runner.stopLiveServer",
          "when": "resourceExtname =~ /\\.(html|htm)$/i && universalRunner:liveServerRunning && !isInDiffEditor",
          "group": "0_server"
        },
        {
          "command": "universal-runner.configureHtmlAction",
          "when": "resourceExtname =~ /\\.(html|htm)$/i && !isInDiffEditor",
          "group": "1_config"
        },
        {
          "command": "universal-runner.runMaz",
          "when": "resourceExtname =~ /\\.maz$/i && !isInDiffEditor",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "universal-runner.stopLiveServer",
          "when": "universalRunner:liveServerRunning && !isInDiffEditor",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Universal Run Button",
      "properties": {
        "universalRunner.toolPaths": {
          "type": "object",
          "default": {},
          "description": "Custom paths for compilers and interpreters (e.g. {\"python\": \"C:\\\\Path\\\\python.exe\", \"gcc\": \"/usr/bin/gcc\"})."
        },
        "universalRunner.htmlDefaultAction": {
          "type": "string",
          "enum": [
            "liveServer",
            "runPath",
            "prompt"
          ],
          "enumDescriptions": [
            "Run with Live Server (local HTTP development server with automatic live reload on file save)",
            "Run Path (open directly in default web browser via file path)",
            "Prompt each time to choose between Live Server and Run Path"
          ],
          "default": "liveServer",
          "description": "Default execution behavior for the Play button when running HTML files."
        },
        "universalRunner.liveServer.provider": {
          "type": "string",
          "enum": [
            "auto",
            "builtIn",
            "extension",
            "customCommand"
          ],
          "enumDescriptions": [
            "Use Ritwick Dey's Live Server extension if installed; otherwise use built-in Live Server",
            "Always use Universal Run Button's built-in live reload server",
            "Always use Ritwick Dey's Live Server extension",
            "Run a custom live server command in the integrated terminal"
          ],
          "default": "auto",
          "description": "The Live Server provider to use when launching Live Server."
        },
        "universalRunner.liveServer.port": {
          "type": "integer",
          "default": 5500,
          "description": "Port number for the built-in Live Server. If this port is occupied, the next available port will be chosen automatically."
        },
        "universalRunner.liveServer.customCommand": {
          "type": "string",
          "default": "",
          "description": "Custom command to start a live server in the integrated terminal (e.g. 'npx live-server' or 'python -m http.server 5500')."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
